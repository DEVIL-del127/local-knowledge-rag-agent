# Copy this file to .env. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

AGENT_EXECUTION_PROFILE=enforce
AGENT_DB=main
AGENT_USER_ID=local
AGENT_STATE_DIR=agent_state

ES_HOST=localhost
ES_PORT=9200
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

INGESTION_REGISTRY_PATH=data/ingestion/generation_registry.sqlite3
MCP_CONFIG=config/mcp/servers.yaml
SEMANTIC_COMPILER_LLM=1
AGENT_LLM_CLARIFICATION=0

# Optional Windows protection bridge used from WSL.
STUDY_PROTECTION_WINDOWS_PYTHON=
STUDY_PROTECTION_WINDOWS_SCRIPT=
